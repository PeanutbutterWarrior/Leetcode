class Solution:
    def longestPalindrome(self, s: str) -> str:
        longest = s[0]
        for left_middle in range(len(s) - 1):
            if s[left_middle] == s[left_middle + 1]:  # Adjacent letters
                pal = self.palindrome_from(s, left_middle, left_middle + 1)
                if len(pal) > len(longest):
                    longest = pal
            
            if left_middle < len(s) - 2 and s[left_middle] == s[left_middle + 2]:  # Off by one letters
                pal = self.palindrome_from(s, left_middle, left_middle + 2)
                if len(pal) > len(longest):
                    longest = pal
        return longest
    
    def palindrome_from(self, s: str, left_middle: int, right_middle: int) -> str:
        i = 1
        while 0 <= left_middle - i and right_middle + i < len(s) and s[left_middle - i] == s[right_middle + i]:
            i += 1
        return s[left_middle - i + 1:right_middle + i]
